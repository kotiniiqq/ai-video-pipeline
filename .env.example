# Copy to .env. Nothing here is needed for the demo: `docker compose up` runs with MODE=demo and no keys.

# demo: offline providers (generated narration text, Piper voice, generated frames, FFmpeg motion)
# live: real providers with your own keys below
MODE=demo

# Demo only: make some shots fail on purpose so the retry and fallback paths run (1 = on)
DEMO_FAULTS=

# --- live mode -------------------------------------------------------------------------------
# LLM via OpenRouter (script, storyboard, titles)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5

# Voice via ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Images (FLUX schnell) and image-to-video via fal.ai
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# Optional: "video ready" / "video failed" messages to a Telegram chat (in demo mode they are only logged)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- local stack -----------------------------------------------------------------------------
# Defaults are local-only; set your own before exposing anything.
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
PIPELINE_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
